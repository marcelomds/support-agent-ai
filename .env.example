# Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgres://streambox:streambox@localhost:5432/streambox
REDIS_URL=redis://localhost:6379
PORT=3000

# Needed from phase 1 (model endpoint) on.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# How much the model thinks before answering: low | medium | high
AGENT_EFFORT=low
# Maximum model calls per customer message.
AGENT_MAX_STEPS=8

# Embedding model for the policy search. Runs locally; downloaded on first use.
EMBEDDING_MODEL=Xenova/multilingual-e5-small
# Sections less similar than this to the question are treated as unrelated.
EMBEDDING_MIN_SIMILARITY=0.8
